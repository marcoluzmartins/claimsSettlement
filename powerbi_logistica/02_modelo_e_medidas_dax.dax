// =====================================================================
// MODELO + DAX  –  LogiDistrib
// Nomes de tabelas = nomes das consultas de 01_power_query_dimensoes.m
// (stg_encomendas e stg_entregas não são carregadas no modelo).
// NOTA: este DAX foi escrito e conferido por cálculo independente
// (pandas, SQL e numpy), mas não foi executado no Power BI Desktop.
// Cada medida traz o valor esperado para o conferir.
// =====================================================================

// ---------------------------------------------------------------------
// A. RELAÇÕES (Vista de modelo) – todas muitos-para-um (*:1), filtro
//    num só sentido (da dimensão para o facto)
// ---------------------------------------------------------------------
//  encomendas[data_encomenda]     *:1  dim_calendario[data]           ATIVA
//  encomendas[data_expedicao]     *:1  dim_calendario[data]           inativa
//  encomendas[data_entrega]       *:1  dim_calendario[data]           inativa
//  encomendas[id_cliente]         *:1  dim_cliente[id_cliente]
//  encomendas[id_centro]          *:1  dim_centro[id_centro]
//  encomendas[id_transportadora]  *:1  dim_transportadora[id_transportadora]
//  linha_encomenda[id_encomenda]  *:1  encomendas[id_encomenda]
//  linha_encomenda[id_produto]    *:1  dim_produto[id_produto]
//  objetivos_2026[id_centro]      *:1  dim_centro[id_centro]
//  objetivos_2026[data_mes]       *:1  dim_calendario[data]  (objetivo no dia 1 do mês)
//
// Grãos: linha_encomenda = produto numa encomenda | encomendas = uma
// encomenda (já com a entrega, 1:1) | objetivos_2026 = centro × mês.
// Marcar dim_calendario como tabela de datas (coluna data).
// Ordenar por coluna: mes_abrev por mes_num; dia_semana por dia_semana_num.


// ---------------------------------------------------------------------
// B. COLUNAS CALCULADAS
// ---------------------------------------------------------------------

// --- dim_calendario ---------------------------------------------------
// Período comparável: mesmo intervalo dia/mês nos dois anos, até à última
// data com encomendas (31/08/2026) -> jan–ago.
periodo_comparavel_2026 =
VAR _lim = CALCULATE ( MAX ( encomendas[data_encomenda] ), ALL () )
RETURN
    IF (
        MONTH ( dim_calendario[data] ) * 100 + DAY ( dim_calendario[data] )
            <= MONTH ( _lim ) * 100 + DAY ( _lim ),
        "Sim",
        "Não"
    )

// --- linha_encomenda --------------------------------------------------
// Custo logístico ALOCADO a cada linha, proporcional ao peso da linha no
// peso total da encomenda. O custo está ao nível da encomenda; sem esta
// alocação, ao analisar por produto/categoria o custo seria repetido ou
// ignorado. Garante que a soma por qualquer dimensão = total (95 498,44 €).
custo_log_aloc =
VAR _pesoEnc =
    CALCULATE (
        SUM ( linha_encomenda[peso_kg] ),
        ALLEXCEPT ( linha_encomenda, linha_encomenda[id_encomenda] )
    )
RETURN
    DIVIDE ( linha_encomenda[peso_kg], _pesoEnc ) * RELATED ( encomendas[custo_transporte] )

// --- encomendas -------------------------------------------------------
// Dias úteis decorridos entre a encomenda e a expedição = dias úteis em
// [data_encomenda ; data_expedicao[. Uma encomenda de fim de semana é
// considerada recebida na 2.ª feira seguinte.
du_processamento =
LOOKUPVALUE ( dim_calendario[du_antes], dim_calendario[data], encomendas[data_expedicao] )
    - LOOKUPVALUE ( dim_calendario[du_antes], dim_calendario[data], encomendas[data_encomenda] )

dentro_prazo_operacional = IF ( encomendas[du_processamento] <= 4, 1, 0 )

// >0 = entregue depois da data prometida (dias de calendário)
atraso_entrega_dias = INT ( encomendas[data_entrega] - encomendas[data_prometida] )

entrega_atrasada = IF ( encomendas[atraso_entrega_dias] > 0, "Atrasada", "No prazo" )

// --- encomendas: variáveis explicativas para o Key Influencers (Q9) ---
// (só informação conhecida no registo da encomenda)
regiao_cliente_diferente_centro =
IF ( RELATED ( dim_cliente[regiao_cliente] ) <> RELATED ( dim_centro[regiao_centro] ), "Sim", "Não" )

peso_total_kg = CALCULATE ( SUM ( linha_encomenda[peso_kg] ) )

n_linhas = CALCULATE ( COUNTROWS ( linha_encomenda ) )

tem_fragil =
IF ( CALCULATE ( COUNTROWS ( linha_encomenda ), dim_produto[fragil] = "Sim" ) > 0, "Sim", "Não" )

dia_semana_encomenda = RELATED ( dim_calendario[dia_semana] )

// Para 9.3/9.4: trânsito real e prometido (a diferença = atraso_entrega_dias)
transito_real_dias      = INT ( encomendas[data_entrega] - encomendas[data_expedicao] )
transito_prometido_dias = INT ( encomendas[data_prometida] - encomendas[data_expedicao] )

// Faixas de peso para validar o fator "peso" (esperado: > 20 kg = 16,9 % atrasadas; ≤ 20 kg = 11,9 %)
faixa_peso_kg =
SWITCH (
    TRUE (),
    encomendas[peso_total_kg] <= 5,  "1) até 5",
    encomendas[peso_total_kg] <= 10, "2) 5 a 10",
    encomendas[peso_total_kg] <= 20, "3) 10 a 20",
    "4) mais de 20"
)


// ---------------------------------------------------------------------
// C. MEDIDAS – Q2 desempenho económico
//    (valores esperados: totais jan 2025–ago 2026, sem filtros)
// ---------------------------------------------------------------------
// Conta encomendas pelas linhas: assim também respeita filtros de produto.
n_encomendas = DISTINCTCOUNT ( linha_encomenda[id_encomenda] )          // 10 693

valor_encomendas =
SUMX ( linha_encomenda, linha_encomenda[quantidade] * linha_encomenda[preco_unitario] )   // 3 424 487,83

custo_produtos =
SUMX ( linha_encomenda, linha_encomenda[quantidade] * RELATED ( dim_produto[custo_unitario] ) )   // 1 962 798,04

custo_logistico = SUM ( linha_encomenda[custo_log_aloc] )               // 95 498,44

margem_contribuicao = [valor_encomendas] - [custo_produtos] - [custo_logistico]    // 1 366 191,35

taxa_margem = DIVIDE ( [margem_contribuicao], [valor_encomendas] )      // 39,89 %

custo_logistico_medio = DIVIDE ( [custo_logistico], [n_encomendas] )    // 8,93 €

ticket_medio = DIVIDE ( [valor_encomendas], [n_encomendas] )            // 320,26 €

// encomendas com margem de contribuição negativa (esperado: 88)
enc_margem_negativa =
COUNTROWS ( FILTER ( VALUES ( encomendas[id_encomenda] ), [margem_contribuicao] < 0 ) )


// ---------------------------------------------------------------------
// D. MEDIDAS – Q3 eficiência e qualidade operacional
//    (indicadores ao nível da ENCOMENDA: não usar a dimensão produto)
// ---------------------------------------------------------------------
n_enc_atrasadas =
CALCULATE ( [n_encomendas], encomendas[entrega_atrasada] = "Atrasada" )     // 1 310

pct_proc_dentro_prazo =
DIVIDE ( CALCULATE ( [n_encomendas], encomendas[dentro_prazo_operacional] = 1 ), [n_encomendas] )   // 93,80 %

pct_entregas_no_prazo = DIVIDE ( [n_encomendas] - [n_enc_atrasadas], [n_encomendas] )    // 87,75 %

pct_entregas_atrasadas = DIVIDE ( COALESCE ( [n_enc_atrasadas], 0 ), [n_encomendas] )       // 12,25 %

// média só das entregas depois da data prometida, em dias de calendário
atraso_medio_dias =
CALCULATE ( AVERAGE ( encomendas[atraso_entrega_dias] ), encomendas[entrega_atrasada] = "Atrasada" )   // 2,51

data_limite = CALCULATE ( MAX ( encomendas[data_encomenda] ), ALL () )      // 31/08/2026


// ---------------------------------------------------------------------
// E. MEDIDAS – Q4 2026 vs período comparável de 2025 (jan–ago)
// Matriz: ano nas colunas, medidas em "Valores", filtro de página
// dim_calendario[periodo_comparavel_2026] = "Sim".
// Valores esperados (2025 -> 2026): N 3 697 -> 4 693 | Valor 1 189 502 ->
// 1 493 004 | Margem 472 078 -> 597 473 | Taxa 39,69 % -> 40,02 % |
// Custo log. médio 9,15 -> 8,71 | % proc. 93,51 % -> 93,80 % |
// % entregas no prazo 88,40 % -> 88,39 % | Atraso médio 2,55 -> 2,55
// ---------------------------------------------------------------------
var_n_encomendas_pct =
VAR _2026 = CALCULATE ( [n_encomendas], dim_calendario[ano] = 2026, dim_calendario[periodo_comparavel_2026] = "Sim" )
VAR _2025 = CALCULATE ( [n_encomendas], dim_calendario[ano] = 2025, dim_calendario[periodo_comparavel_2026] = "Sim" )
RETURN DIVIDE ( _2026 - _2025, _2025 )                                   // +26,9 %

var_valor_encomendas_pct =
VAR _2026 = CALCULATE ( [valor_encomendas], dim_calendario[ano] = 2026, dim_calendario[periodo_comparavel_2026] = "Sim" )
VAR _2025 = CALCULATE ( [valor_encomendas], dim_calendario[ano] = 2025, dim_calendario[periodo_comparavel_2026] = "Sim" )
RETURN DIVIDE ( _2026 - _2025, _2025 )                                   // +25,5 %

var_custo_logistico_medio_pct =
VAR _2026 = CALCULATE ( [custo_logistico_medio], dim_calendario[ano] = 2026, dim_calendario[periodo_comparavel_2026] = "Sim" )
VAR _2025 = CALCULATE ( [custo_logistico_medio], dim_calendario[ano] = 2025, dim_calendario[periodo_comparavel_2026] = "Sim" )
RETURN DIVIDE ( _2026 - _2025, _2025 )                                   // -4,8 %

var_taxa_margem_pp =
VAR _2026 = CALCULATE ( [taxa_margem], dim_calendario[ano] = 2026, dim_calendario[periodo_comparavel_2026] = "Sim" )
VAR _2025 = CALCULATE ( [taxa_margem], dim_calendario[ano] = 2025, dim_calendario[periodo_comparavel_2026] = "Sim" )
RETURN ( _2026 - _2025 ) * 100                                           // +0,3 pp

var_pct_entregas_no_prazo_pp =
VAR _2026 = CALCULATE ( [pct_entregas_no_prazo], dim_calendario[ano] = 2026, dim_calendario[periodo_comparavel_2026] = "Sim" )
VAR _2025 = CALCULATE ( [pct_entregas_no_prazo], dim_calendario[ano] = 2025, dim_calendario[periodo_comparavel_2026] = "Sim" )
RETURN ( _2026 - _2025 ) * 100                                           // 0,0 pp

var_pct_proc_dentro_prazo_pp =
VAR _2026 = CALCULATE ( [pct_proc_dentro_prazo], dim_calendario[ano] = 2026, dim_calendario[periodo_comparavel_2026] = "Sim" )
VAR _2025 = CALCULATE ( [pct_proc_dentro_prazo], dim_calendario[ano] = 2025, dim_calendario[periodo_comparavel_2026] = "Sim" )
RETURN ( _2026 - _2025 ) * 100                                           // +0,3 pp

var_margem_contribuicao_pct =
VAR _2026 = CALCULATE ( [margem_contribuicao], dim_calendario[ano] = 2026, dim_calendario[periodo_comparavel_2026] = "Sim" )
VAR _2025 = CALCULATE ( [margem_contribuicao], dim_calendario[ano] = 2025, dim_calendario[periodo_comparavel_2026] = "Sim" )
RETURN DIVIDE ( _2026 - _2025, _2025 )                                   // +26,6 %

var_atraso_medio_dias =
VAR _2026 = CALCULATE ( [atraso_medio_dias], dim_calendario[ano] = 2026, dim_calendario[periodo_comparavel_2026] = "Sim" )
VAR _2025 = CALCULATE ( [atraso_medio_dias], dim_calendario[ano] = 2025, dim_calendario[periodo_comparavel_2026] = "Sim" )
RETURN _2026 - _2025                                                     // ≈ 0,00

// Crescimento: vem de novos clientes ou dos mesmos? (esperado: 229 nos dois anos;
// 16,1 -> 20,5 encomendas por cliente; ticket médio 321,75 -> 318,13 €)
clientes_ativos = DISTINCTCOUNT ( encomendas[id_cliente] )
encomendas_por_cliente = DIVIDE ( [n_encomendas], [clientes_ativos] )


// ---------------------------------------------------------------------
// F. MEDIDAS – Q5 objetivos 2026 (centro × mês, jan–ago)
// Médias ponderadas pelo volume objetivo (não médias simples de médias).
// ---------------------------------------------------------------------
volume_objetivo_total = SUM ( objetivos_2026[volume_objetivo] )               // 4 022

custo_medio_objetivo =
DIVIDE (
    SUMX ( objetivos_2026, objetivos_2026[volume_objetivo] * objetivos_2026[custo_medio_objetivo] ),
    [volume_objetivo_total]
)                                                                       // 9,02 €

taxa_prazo_objetivo =
DIVIDE (
    SUMX ( objetivos_2026, objetivos_2026[volume_objetivo] * objetivos_2026[taxa_entrega_prazo_objetivo] ),
    [volume_objetivo_total]
)                                                                       // 89,68 %

// Realizado só em 2026 (os objetivos só existem para 2026), mesmo que o
// utilizador deixe 2025 no contexto de filtro.
volume_2026      = CALCULATE ( [n_encomendas], dim_calendario[ano] = 2026 )               // 4 693
custo_medio_2026 = CALCULATE ( [custo_logistico_medio], dim_calendario[ano] = 2026 )      // 8,71 €
taxa_prazo_2026  = CALCULATE ( [pct_entregas_no_prazo], dim_calendario[ano] = 2026 )      // 88,39 %

desvio_volume_pct    = DIVIDE ( [volume_2026] - [volume_objetivo_total], [volume_objetivo_total] )      // +16,7 %
desvio_custo_medio = [custo_medio_2026] - [custo_medio_objetivo]                          // -0,31 € (negativo = melhor)
desvio_taxa_prazo_pp = ( [taxa_prazo_2026] - [taxa_prazo_objetivo] ) * 100                // -1,3 pp (negativo = pior)

// OPCIONAL (avançado): nº de centro-mês (de 64) que cumprem cada objetivo.
// Esperado: volume 49 | custo médio 43 | pontualidade 20 | os três 10.
meses_cumpre_volume =
SUMX ( SUMMARIZE ( objetivos_2026, dim_centro[id_centro], dim_calendario[ano], dim_calendario[mes_num] ),
    IF ( [volume_2026] >= [volume_objetivo_total], 1, 0 ) )

meses_cumpre_custo =
SUMX ( SUMMARIZE ( objetivos_2026, dim_centro[id_centro], dim_calendario[ano], dim_calendario[mes_num] ),
    IF ( [custo_medio_2026] <= [custo_medio_objetivo], 1, 0 ) )

meses_cumpre_taxa_prazo =
SUMX ( SUMMARIZE ( objetivos_2026, dim_centro[id_centro], dim_calendario[ano], dim_calendario[mes_num] ),
    IF ( [taxa_prazo_2026] >= [taxa_prazo_objetivo], 1, 0 ) )

meses_cumpre_todos =
SUMX ( SUMMARIZE ( objetivos_2026, dim_centro[id_centro], dim_calendario[ano], dim_calendario[mes_num] ),
    IF ( [volume_2026] >= [volume_objetivo_total]
        && [custo_medio_2026] <= [custo_medio_objetivo]
        && [taxa_prazo_2026] >= [taxa_prazo_objetivo], 1, 0 ) )


// ---------------------------------------------------------------------
// G. MEDIDAS – Q8 / Q9 (prioridade e validação do Key Influencers)
// ---------------------------------------------------------------------
// Matriz da validação independente (9.3): linhas = dim_cliente[regiao_cliente],
// valores = [pct_entregas_atrasadas] e [n_encomendas]. Esperado: Interior 23,5 %
// (1 393 enc.) vs 9,5–11,6 % nas restantes regiões.

// Atrasos evitáveis se o Interior tivesse a taxa de atraso do resto do país
// (jan–ago 2026). Esperado: ~96 entregas (-> pontualidade global 90,4 %).
atrasos_evitaveis_interior =
VAR _nInt =
    CALCULATE ( [n_encomendas], dim_cliente[regiao_cliente] = "Interior", dim_calendario[ano] = 2026, dim_calendario[periodo_comparavel_2026] = "Sim" )
VAR _atrInt =
    CALCULATE ( [n_enc_atrasadas], dim_cliente[regiao_cliente] = "Interior", dim_calendario[ano] = 2026, dim_calendario[periodo_comparavel_2026] = "Sim" )
VAR _txResto =
    CALCULATE (
        DIVIDE ( [n_enc_atrasadas], [n_encomendas] ),
        dim_cliente[regiao_cliente] <> "Interior", dim_calendario[ano] = 2026, dim_calendario[periodo_comparavel_2026] = "Sim"
    )
RETURN _atrInt - _nInt * _txResto

// Pontualidade global (jan–ago 2026) se o Interior tivesse a taxa do resto. Esperado: 90,4 %
// (atual: 88,4 %; objetivo: 89,7 %).
taxa_prazo_sem_gap_interior =
VAR _nTot   = CALCULATE ( [n_encomendas], dim_calendario[ano] = 2026, dim_calendario[periodo_comparavel_2026] = "Sim" )
VAR _atrTot = CALCULATE ( [n_enc_atrasadas], dim_calendario[ano] = 2026, dim_calendario[periodo_comparavel_2026] = "Sim" )
RETURN 1 - DIVIDE ( _atrTot - [atrasos_evitaveis_interior], _nTot )

// Alternativa: encomendas "recuperáveis" se o Centro Interior (C08) voltasse ao nível de 2025
// no processamento ≤ 4 d.u. Esperado: ~21.
enc_recuperaveis_c08 =
VAR _n   = CALCULATE ( [n_encomendas], dim_centro[id_centro] = "C08", dim_calendario[ano] = 2026, dim_calendario[periodo_comparavel_2026] = "Sim" )
VAR _p26 = CALCULATE ( [pct_proc_dentro_prazo], dim_centro[id_centro] = "C08", dim_calendario[ano] = 2026, dim_calendario[periodo_comparavel_2026] = "Sim" )
VAR _p25 = CALCULATE ( [pct_proc_dentro_prazo], dim_centro[id_centro] = "C08", dim_calendario[ano] = 2025, dim_calendario[periodo_comparavel_2026] = "Sim" )
RETURN _n * ( _p25 - _p26 )
